@model G3AspNet.Models.RepairPart

@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Editar Línea de Recambio" : "Añadir Recambio";
}

<div class="card shadow-sm mt-3">
    <div class="card-header @(isEdit ? "bg-warning text-dark" : "bg-primary text-white")">
        <h4 class="mb-0">@ViewData["Title"]</h4>
    </div>
    <div class="card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            @if (isEdit)
            {
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RepairId" />
                <input type="hidden" asp-for="SparePartId" />
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="RepairId" class="form-label">Reparación</label>
                    @if (isEdit)
                    {
                        <input class="form-control" value="Reparación #@Model.RepairId" disabled />
                    }
                    else
                    {
                        <select asp-for="RepairId" class="form-select" asp-items="ViewBag.RepairId">
                            <option value="">-- Selecciona Reparación --</option>
                        </select>
                    }
                    <span asp-validation-for="RepairId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SparePartId" class="form-label">Pieza de Recambio</label>
                    @if (isEdit)
                    {
                        <input class="form-control" value="@Model.SparePart?.Name" disabled />
                    }
                    else
                    {
                        <select asp-for="SparePartId" class="form-select" asp-items="ViewBag.SparePartId">
                            <option value="">-- Selecciona Pieza --</option>
                        </select>
                    }
                    <span asp-validation-for="SparePartId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Quantity" class="form-label">Cantidad</label>
                    <input asp-for="Quantity" type="number" min="1" class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="UnitPrice" class="form-label">Precio Unitario (Opcional)</label>
                    <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" placeholder="Dejar vacío para precio base" />
                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn @(isEdit ? "btn-warning" : "btn-primary")">Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}