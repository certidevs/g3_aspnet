@model Repair
@{
    ViewData["Title"] = "Eliminar reparación";
}

<a class="btn btn-outline-secondary mb-3" asp-action="Details" asp-route-id="@Model.Id">Volver a la reparación</a>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 text-danger">Eliminar reparación #@Model.Id</h1>
                <p>
                    Vas a eliminar la reparación del vehículo 
                    <strong>@(Model.Vehicle != null ? $"{Model.Vehicle.LicensePlate} - {Model.Vehicle.Brand} {Model.Vehicle.Model}" : "Sin vehículo asignado")</strong>.
                    Esta acción devolverá las piezas al stock y no se puede deshacer.
                </p>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    <button class="btn btn-danger" type="submit">Eliminar definitivamente</button>
                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
