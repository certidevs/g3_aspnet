@model IEnumerable<Repair>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Reparaciones</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva reparación</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="status">No hay reparaciones registradas.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Listado de reparaciones</caption>
            <thead class="table-light">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Vehículo</th>
                <th scope="col">Mecánico</th>
                <th scope="col">Tipo</th>
                <th scope="col">Estado</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Vehicle?.LicensePlate</td>
                    <td>@(item.Mechanic?.DisplayName ?? item.Mechanic?.UserName)</td>
                    <td>@item.RepairType</td>
                    <td><span class="badge text-bg-secondary">@item.Status</span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id"
                           aria-label="Ver reparación @item.Id">Ver</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id"
                           aria-label="Editar reparación @item.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id"
                           aria-label="Eliminar reparación @item.Id">Eliminar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
