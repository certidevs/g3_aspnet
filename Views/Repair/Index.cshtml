@model IEnumerable<G3AspNet.Models.Repair>

@{
    ViewData["Title"] = "Listado de Reparaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Reparaciones</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i> Nueva Reparación
    </a>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Vehículo</th>
                <th>Mecánico</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Fecha Entrada</th>
                <th class="text-end">Horas</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">No hay reparaciones registradas.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Id</td>
                    <td>@item.Vehicle?.LicensePlate (@item.Vehicle?.Brand @item.Vehicle?.Model)</td>
                    <td>@(item.Mechanic?.DisplayName ?? item.Mechanic?.UserName ?? "Sin asignar")</td>
                    <td><span class="badge bg-secondary">@Html.DisplayFor(_ => item.RepairType)</span></td>
                    <td>
                        <span class="badge @(item.Status.ToString() == "Completed" ? "bg-success" : "bg-info text-dark")">
                            @Html.DisplayFor(_ => item.Status)
                        </span>
                    </td>
                    <td>@item.OpenedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">@item.LaborHours.ToString("N2") h</td>
                    <td class="text-center">
                        <div class="btn-group" role="group">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Ver detalles">
                                Ver
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                Editar
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger" 
                                    data-bs-toggle="modal" 
                                    data-bs-target="#deleteRepairModal" 
                                    data-repair-id="@item.Id"
                                    data-repair-vehicle="@item.Vehicle?.LicensePlate">
                                Eliminar
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal de Confirmación de Eliminación -->
<div class="modal fade" id="deleteRepairModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¿Seguro que deseas eliminar la reparación <strong id="deleteRepairLabel"></strong>?
                <br /><small class="text-muted">Las piezas asociadas serán reintegradas al inventario.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="deleteForm" asp-action="Delete" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteRepairIdInput" value="" />
                    <button type="submit" class="btn btn-danger">Eliminar Reparación</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById('deleteRepairModal');
        modal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const repairId = button.getAttribute('data-repair-id');
            const vehicle = button.getAttribute('data-repair-vehicle');

            document.getElementById('deleteRepairIdInput').value = repairId;
            document.getElementById('deleteRepairLabel').textContent = '#' + repairId + ' (' + vehicle + ')';
        });
    </script>
}