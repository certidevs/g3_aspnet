@model Repair

@{
    ViewData["Title"] = $"Reparación #{Model.Id}";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0"> Detalle de reparación #@Model.Id</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Eliminar</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    </div>
</div>
<div class="card mb-4">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Vehículo</dt>
            <dd class="col-sm-9">@Model.Vehicle?.LicensePlate (@Model.Vehicle?.Brand @Model.Vehicle?.Model)</dd>

            <dt class="col-sm-3">Mecánico</dt>
            <dd class="col-sm-9">@(Model.Mechanic?.DisplayName ?? Model.Mechanic?.UserName)</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Coste total</dt>
            <dd class="col-sm-9">@Model.TotalCost.ToString("C")</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent">
        <a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a>
    </div>
</div>
