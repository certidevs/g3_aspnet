<ul id="passwordRequirements" class="password-requirements list-unstyled small mt-3 mb-0" aria-label="Requisitos de la contraseña">
    <li data-rule="length">
        <i class="fa-regular fa-circle me-1" aria-hidden="true"></i>Mínimo <span id="passwordMinLength">8</span> caracteres<span class="visually-hidden"> (pendiente)</span>
    </li>
    <li data-rule="lower">
        <i class="fa-regular fa-circle me-1" aria-hidden="true"></i>Una letra minúscula<span class="visually-hidden"> (pendiente)</span>
    </li>
    <li data-rule="upper">
        <i class="fa-regular fa-circle me-1" aria-hidden="true"></i>Una letra mayúscula<span class="visually-hidden"> (pendiente)</span>
    </li>
    <li data-rule="digit">
        <i class="fa-regular fa-circle me-1" aria-hidden="true"></i>Un número<span class="visually-hidden"> (pendiente)</span>
    </li>
    <li data-rule="special">
        <i class="fa-regular fa-circle me-1" aria-hidden="true"></i>Un carácter especial<span class="visually-hidden"> (pendiente)</span>
    </li>
</ul>

<script>
    (() => {
        const input = document.getElementById("Password");
        const list = document.getElementById("passwordRequirements");
        if (!input || !list) return;

        // El mínimo lo escribe ASP.NET en el campo a partir de [StringLength(MinimumLength = ...)].
        const minLength = Number(input.dataset.valLengthMin) || 8;
        document.getElementById("passwordMinLength").textContent = minLength;

        // Mismas definiciones que usa Identity en el servidor (letra, dígito, no alfanumérico).
        const rules = {
            length: value => value.length >= minLength,
            lower: value => /\p{Ll}/u.test(value),
            upper: value => /\p{Lu}/u.test(value),
            digit: value => /\p{Nd}/u.test(value),
            special: value => /[^\p{L}\p{Nd}]/u.test(value)
        };

        const update = () => {
            list.querySelectorAll("li[data-rule]").forEach(item => {
                const met = rules[item.dataset.rule](input.value);
                const icon = item.querySelector("i");

                item.classList.toggle("is-met", met);
                icon.classList.toggle("fa-solid", met);
                icon.classList.toggle("fa-circle-check", met);
                icon.classList.toggle("fa-regular", !met);
                icon.classList.toggle("fa-circle", !met);
                item.querySelector(".visually-hidden").textContent = met ? " (cumplido)" : " (pendiente)";
            });
        };

        input.addEventListener("input", update);
        update();
    })();
</script>
