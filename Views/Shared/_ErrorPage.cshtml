@model G3AspNet.ViewModels.Errors.ErrorPageViewModel

<div class="taller-home">
    <!-- Misma cabecera oscura que la portada -->
    <section class="taller-hero rounded-4 overflow-hidden">
        <div class="row g-0 align-items-center">
            <div class="col-lg-6 p-4 p-lg-5 text-white">
                <p class="taller-tag mb-3"><i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>@Model.Tag</p>
                <h1 class="taller-title mb-3">@Model.Title <br /><span class="taller-red">@Model.Highlight</span></h1>
                <p class="lead taller-lead mb-4">@Model.Message</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary btn-lg" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-house me-2" aria-hidden="true"></i>Volver al inicio
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-outline-light btn-lg" asp-controller="Repairs" asp-action="Index">
                            <i class="fa-solid fa-screwdriver-wrench me-2" aria-hidden="true"></i>Mis reparaciones
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">
                            <i class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></i>Iniciar sesión
                        </a>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.RequestId))
                {
                    <p class="taller-request-id mt-4 mb-0">Identificador de petición: <code>@Model.RequestId</code></p>
                }
            </div>
            <div class="col-lg-6 taller-hero-art">
                @* Decorativa: el mensaje ya está en el texto *@
                <img class="img-fluid w-100" src="~/images/@Model.Image" width="560" height="340" alt="" />
            </div>
        </div>
        <div class="taller-stripe" aria-hidden="true"></div>
    </section>
</div>
