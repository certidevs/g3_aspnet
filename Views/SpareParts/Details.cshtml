@model SparePart
@{
    ViewData["Title"] = $"Recambio {Model.Name}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@Model.Name</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('¿Eliminar este recambio?');">
            <button type="submit" class="btn btn-outline-danger">Eliminar</button>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Referencia</dt>
            <dd class="col-sm-9">@Model.Reference</dd>

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Marca</dt>
            <dd class="col-sm-9">@Model.Brand</dd>

            <dt class="col-sm-3">Precio unitario</dt>
            <dd class="col-sm-9">@Model.UnitPrice.ToString("N2")&nbsp;€</dd>

            <dt class="col-sm-3">Stock</dt>
            <dd class="col-sm-9">@Model.Stock unidades</dd>

            <dt class="col-sm-3">Stock mínimo</dt>
            <dd class="col-sm-9">@Model.MinStock unidades</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent">
        <a class="btn btn-outline-secondary" asp-action="Index">Volver a recambios</a>
    </div>
</div>

<h2 class="h4 mb-3">Reparaciones en las que se ha usado</h2>

@if (Model.RepairParts.Count == 0)
{
    <div class="alert alert-info" role="status">Este recambio todavía no se ha usado en ninguna reparación.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Reparaciones que usan este recambio</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">Reparación</th>
                    <th scope="col">Vehículo</th>
                    <th scope="col">Cantidad</th>
                    <th scope="col">Precio unitario</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var part in Model.RepairParts)
                {
                    <tr>
                        <td><a asp-controller="Repairs" asp-action="Details" asp-route-id="@part.RepairId">#@part.RepairId</a></td>
                        <td>@part.Repair.Vehicle.LicensePlate</td>
                        <td>@part.Quantity</td>
                        <td>@part.UnitPrice.ToString("N2")&nbsp;€</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
