@model IEnumerable<RepairPart>
@{
    ViewData["Title"] = "Piezas usadas";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Piezas usadas en reparaciones</h1>
        <p class="text-secondary mb-0">Cada línea une una reparación con un recambio, con su cantidad y su precio unitario.</p>
    </div>
    @* DESCOMENTA: <a class="btn btn-primary" asp-action="Create">Añadir pieza</a> *@
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="status">No hay piezas asignadas a reparaciones.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Listado de piezas usadas en reparaciones</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">Reparación</th>
                    <th scope="col">Vehículo</th>
                    <th scope="col">Recambio</th>
                    <th scope="col">Cantidad</th>
                    <th scope="col">Precio unitario</th>
                    <th scope="col">Subtotal</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a asp-controller="Repair" asp-action="Details" asp-route-id="@item.RepairId">#@item.RepairId</a></td>
                        <td>@item.Repair.Vehicle.LicensePlate</td>
                        <td><a asp-controller="SpareParts" asp-action="Details" asp-route-id="@item.SparePartId">@item.SparePart.Name</a></td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice.ToString("N2")&nbsp;€</td>
                        <td>@((item.Quantity * item.UnitPrice).ToString("N2"))&nbsp;€</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id"
                               aria-label="Ver pieza @item.Id">Ver</a>
                            @* DESCOMENTA: <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id" aria-label="Editar pieza @item.Id">Editar</a> *@
                            @* DESCOMENTA: <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id" aria-label="Eliminar pieza @item.Id">Eliminar</a> *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
