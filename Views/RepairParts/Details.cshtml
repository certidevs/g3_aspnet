@model RepairPart
@{
    ViewData["Title"] = $"Pieza usada #{Model.Id}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Pieza usada #@Model.Id</h1>
    <div class="d-flex gap-2">
        @* DESCOMENTA: <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> *@
        @* DESCOMENTA: <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Eliminar</a> *@
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Reparación</dt>
            <dd class="col-sm-9"><a asp-controller="Repair" asp-action="Details" asp-route-id="@Model.RepairId">#@Model.RepairId</a> (@Model.Repair.Description)</dd>

            <dt class="col-sm-3">Vehículo</dt>
            <dd class="col-sm-9">
                <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@Model.Repair.VehicleId">@Model.Repair.Vehicle.LicensePlate</a>
            </dd>

            <dt class="col-sm-3">Recambio</dt>
            <dd class="col-sm-9">
                <a asp-controller="SpareParts" asp-action="Details" asp-route-id="@Model.SparePartId">@Model.SparePart.Name</a>
                (@Model.SparePart.Brand, ref. @Model.SparePart.Reference)
            </dd>

            <dt class="col-sm-3">Cantidad</dt>
            <dd class="col-sm-9">@Model.Quantity</dd>

            <dt class="col-sm-3">Precio unitario</dt>
            <dd class="col-sm-9">@Model.UnitPrice.ToString("N2")&nbsp;€ (precio en el momento de usar la pieza)</dd>

            <dt class="col-sm-3">Subtotal</dt>
            <dd class="col-sm-9 fw-semibold">@((Model.Quantity * Model.UnitPrice).ToString("N2"))&nbsp;€</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent">
        <a class="btn btn-outline-secondary" asp-action="Index">Volver a piezas usadas</a>
    </div>
</div>
