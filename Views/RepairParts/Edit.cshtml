@model RepairPart
@{
    ViewData["Title"] = $"Editar pieza #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Editar pieza #@Model.Id</h1>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card">
    <input type="hidden" asp-for="Id" />
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="RepairId" class="form-label">Reparación</label>
                <select asp-for="RepairId" asp-items="ViewBag.Repairs" class="form-select"></select>
                <span asp-validation-for="RepairId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SparePartId" class="form-label">Recambio</label>
                <select asp-for="SparePartId" asp-items="ViewBag.SpareParts" class="form-select"></select>
                <span asp-validation-for="SparePartId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Quantity" class="form-label">Cantidad</label>
                <input asp-for="Quantity" class="form-control" min="1" max="1000" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="UnitPrice" class="form-label">Precio unitario</label>
                <input asp-for="UnitPrice" class="form-control" min="0" max="100000" step="0.01" />
                <span asp-validation-for="UnitPrice" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="card-footer"><button class="btn btn-primary" type="submit">Guardar</button></div>
</form>
