@model RepairPart
@{
    ViewData["Title"] = "Añadir pieza";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Añadir pieza a una reparación</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</div>

<div class="alert alert-warning">TODO (issue #18): descomenta el formulario y ajústalo</div>

@* DESCOMENTA DESDE AQUÍ
<form asp-action="Create" method="post" class="card">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="RepairId" class="form-label">Reparación</label>
                <select asp-for="RepairId" asp-items="ViewBag.Repairs" class="form-select">
                    <option value="">-- Seleccionar reparación --</option>
                </select>
                <span asp-validation-for="RepairId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SparePartId" class="form-label">Recambio</label>
                <select asp-for="SparePartId" asp-items="ViewBag.SpareParts" class="form-select">
                    <option value="">-- Seleccionar recambio --</option>
                </select>
                <span asp-validation-for="SparePartId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Quantity" class="form-label">Cantidad</label>
                <input asp-for="Quantity" class="form-control" min="1" max="1000" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="card-footer"><button class="btn btn-primary" type="submit">Añadir</button></div>
</form>
FIN DESCOMENTA *@
