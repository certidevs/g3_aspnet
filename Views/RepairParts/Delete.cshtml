@model RepairPart
@{
    ViewData["Title"] = "Eliminar pieza";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger">
            <div class="card-body p-4">
                <h1 class="h3 text-danger">Eliminar pieza #@Model.Id</h1>
                <p>Vas a quitar <strong>@Model.Quantity × @Model.SparePart.Name</strong> de la reparación <strong>#@Model.RepairId</strong>. El stock se restablecerá.</p>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    <button class="btn btn-danger" type="submit">Eliminar definitivamente</button>
                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
