@model G3AspNet.ViewModels.RepairParts.RepairPartFormViewModel
@{
    var isNew = Model.Id == 0;
    var isAdmin = User.IsInRole(RoleNames.Admin);
    ViewData["Title"] = isNew ? "Añadir pieza" : $"Editar pieza #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">@(isNew ? "Añadir pieza a una reparación" : $"Editar pieza #{Model.Id}")</h1>
    @if (isNew)
    {
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    }
    else
    {
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a>
    }
</div>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" class="card shadow-sm">
    @if (!isNew)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="RepairId" class="form-label">Reparación</label>
                <select asp-for="RepairId" asp-items="ViewBag.Repairs" class="form-select">
                    @if (isNew)
                    {
                        <option value="">-- Seleccionar reparación --</option>
                    }
                </select>
                <span asp-validation-for="RepairId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SparePartId" class="form-label">Recambio</label>
                <select asp-for="SparePartId" asp-items="ViewBag.SpareParts" class="form-select">
                    @if (isNew)
                    {
                        <option value="">-- Seleccionar recambio --</option>
                    }
                </select>
                <span asp-validation-for="SparePartId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Quantity" class="form-label">Cantidad</label>
                <input asp-for="Quantity" type="number" class="form-control" min="1" max="1000" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            @if (!isNew && isAdmin)
            {
                <div class="col-md-6">
                    <label asp-for="UnitPrice" class="form-label">Precio unitario (€)</label>
                    <input asp-for="UnitPrice" type="number" class="form-control" min="0" max="100000" step="0.01" />
                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                </div>
            }
        </div>
    </div>
    <div class="card-footer bg-transparent text-end">
        <button class="btn btn-primary" type="submit">@(isNew ? "Añadir" : "Guardar")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
