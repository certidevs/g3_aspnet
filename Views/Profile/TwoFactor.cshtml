@model TwoFactorViewModel
@{
    ViewData["Title"] = "Autenticación en dos pasos (2FA)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Autenticación en dos pasos (2FA)</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver al perfil</a>
</div>

<div class="card">
    <div class="card-body p-4">
        @if (Model.Is2faEnabled)
        {
            <div class="alert alert-success">
                Tu cuenta tiene activada la verificación en dos pasos mediante aplicación autenticadora (TOTP).
            </div>
            <form asp-action="DisableTwoFactor" method="post"
                  onsubmit="return confirm('¿Seguro que deseas desactivar el 2FA en tu cuenta?');">
                <button type="submit" class="btn btn-outline-danger">Desactivar 2FA</button>
            </form>
        }
        else
        {
            @if (User.IsInRole(RoleNames.Admin))
            {
                <div class="alert alert-warning">
                    Recomendación de seguridad: las cuentas con rol <strong>Admin</strong> deben activar TOTP 2FA.
                </div>
            }
            <div class="row g-4">
                <div class="col-md-auto text-center">
                    <img class="img-fluid rounded border" src="@Model.QrCodeImage" width="220" height="220"
                         alt="Código QR para añadir esta cuenta a tu aplicación autenticadora" />
                </div>
                <div class="col-md">
                    <p>Escanea el código QR con tu aplicación autenticadora (Google Authenticator, Microsoft Authenticator, Bitwarden, etc.) y escribe el código de 6 dígitos que te muestre.</p>
                    <p class="mb-2">¿No puedes escanearlo? Introduce esta clave secreta:</p>
                    <div class="p-3 bg-body-secondary rounded mb-3">
                        <code class="fs-6">@Model.SharedKey</code>
                    </div>
                    <details class="small text-secondary mb-3">
                        <summary>Mostrar URI TOTP</summary>
                        <code class="text-break">@Model.AuthenticatorUri</code>
                    </details>

                    <form asp-action="EnableTwoFactor" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row g-3">
                            <div class="col-lg-7">
                                <label asp-for="Code" class="form-label"></label>
                                <input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" placeholder="123456" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">Activar 2FA</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
