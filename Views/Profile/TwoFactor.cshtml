@model TwoFactorViewModel
@{
    ViewData["Title"] = "Autenticación en dos pasos (2FA)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Autenticación en dos pasos (2FA)</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver al perfil</a>
</div>

<div class="card">
    <div class="card-body p-4">
        @if (Model.Is2faEnabled)
        {
            <div class="alert alert-success">
                Tu cuenta tiene activada la verificación en dos pasos mediante aplicación autenticadora (TOTP).
            </div>
            <form asp-action="DisableTwoFactor" method="post"
                  onsubmit="return confirm('¿Seguro que deseas desactivar el 2FA en tu cuenta?');">
                <button type="submit" class="btn btn-outline-danger">Desactivar 2FA</button>
            </form>
        }
        else
        {
            @if (User.IsInRole(RoleNames.Admin))
            {
                <div class="alert alert-warning">
                    Recomendación de seguridad: las cuentas con rol <strong>Admin</strong> deben activar TOTP 2FA.
                </div>
            }
            <p>Configura tu aplicación autenticadora (Google Authenticator, Microsoft Authenticator, Bitwarden, etc.) introduciendo la siguiente clave secreta:</p>
            <div class="p-3 bg-body-secondary rounded mb-3">
                <code class="fs-6">@Model.SharedKey</code>
            </div>
            <p class="small text-secondary mb-3">
                URI TOTP: <code>@Model.AuthenticatorUri</code>
            </p>

            <form asp-action="EnableTwoFactor" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label asp-for="Code" class="form-label"></label>
                        <input asp-for="Code" class="form-control" autocomplete="one-time-code" placeholder="123456" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary">Activar 2FA</button>
                    </div>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
