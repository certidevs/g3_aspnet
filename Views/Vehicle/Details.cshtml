@model Vehicle
@{
    ViewData["Title"] = $"Vehículo {Model.LicensePlate}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Vehículo @Model.LicensePlate</h1>
    <div class="d-flex gap-2">
        @* DESCOMENTA: <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> *@
        @* DESCOMENTA: <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Eliminar este vehículo?');"><button type="submit" class="btn btn-outline-danger">Eliminar</button></form> *@
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Matrícula</dt>
            <dd class="col-sm-9">@Model.LicensePlate</dd>

            <dt class="col-sm-3">VIN</dt>
            <dd class="col-sm-9">@Model.VIN</dd>

            <dt class="col-sm-3">Marca y modelo</dt>
            <dd class="col-sm-9">@Model.Brand @Model.Model</dd>

            <dt class="col-sm-3">Año</dt>
            <dd class="col-sm-9">@Model.Year</dd>

            <dt class="col-sm-3">Combustible</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.FuelType)</dd>

            <dt class="col-sm-3">Kilometraje</dt>
            <dd class="col-sm-9">@Model.Mileage.ToString("N0") km</dd>

            <dt class="col-sm-3">Propietario</dt>
            <dd class="col-sm-9">@(Model.Owner.DisplayName ?? Model.Owner.UserName)</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent">
        <a class="btn btn-outline-secondary" asp-action="Index">Volver a vehículos</a>
    </div>
</div>

<h2 class="h4 mb-3">Historial de reparaciones</h2>

@if (Model.Repairs.Count == 0)
{
    <div class="alert alert-info" role="status">Este vehículo todavía no tiene reparaciones.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Reparaciones del vehículo</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">Reparación</th>
                    <th scope="col">Fecha de apertura</th>
                    <th scope="col">Descripción</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Mecánico</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var repair in Model.Repairs.OrderByDescending(r => r.OpenedAt))
                {
                    <tr>
                        <td><a asp-controller="Repair" asp-action="Details" asp-route-id="@repair.Id">#@repair.Id</a></td>
                        <td>@repair.OpenedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>@repair.Description</td>
                        <td>@Html.DisplayFor(m => repair.RepairType)</td>
                        <td><span class="badge text-bg-secondary">@Html.DisplayFor(m => repair.Status)</span></td>
                        <td>@(repair.Mechanic.DisplayName ?? repair.Mechanic.UserName)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
