<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>G3AspNet</RootNamespace>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core proporciona el acceso ORM a la base de datos SQLite. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Identity proporciona login, cookies, contraseñas y roles. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.2" />
  </ItemGroup>

  <!-- Recursos de la factura en PDF: las fuentes y la ilustración de la portada. -->
  <ItemGroup>
    <EmbeddedResource Include="Services/Invoices/Fonts/*.ttf" LogicalName="Invoice.Fonts.%(Filename).ttf" />
    <EmbeddedResource Include="wwwroot/images/hero-taller.svg" LogicalName="Invoice.hero-taller.svg" />
  </ItemGroup>

  <!-- El SDK incluye todos los archivos bajo la raíz; la carpeta tests pertenece a su
       propio proyecto y no debe compilarse ni copiarse como contenido de la web. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
