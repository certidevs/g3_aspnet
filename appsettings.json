{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/g3.db"
  },
  "Database": {
    "RecreateOnStartup": false
  },
  "SeedData": {
    "Enabled": false
  },
  "Invoice": {
    "VatRate": 21,
    "IssuerName": "TALLER .NET",
    "IssuerTaxId": "",
    "IssuerAddress": ""
  },
  "FileUploads": {
    "Images": {
      "MaxFileSizeBytes": 5242880,
      "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
